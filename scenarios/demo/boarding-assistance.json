{
  "schema_version": 1,
  "id": "demo-boarding-assistance",
  "version": 1,
  "title": "Синтетическое демо: Помощь при посадке",
  "cycle_policy": "forbid",
  "start_node_id": "request",
  "competency_ids": [
    "coordination"
  ],
  "nodes": [
    {
      "id": "request",
      "text": "В вымышленном поезде пассажир просит помочь с тяжёлой сумкой. Проход узкий, рядом другие люди. Это синтетическая ситуация, не производственная инструкция.",
      "time_limit_seconds": 60,
      "choices": [
        {
          "id": "coordinate",
          "text": "Уточнить, какая помощь нужна, и освободить проход",
          "destination": "followup",
          "explanation": "Согласованные действия оставляют проход свободным и снижают риск в этой учебной модели.",
          "effects": [
            {
              "type": "add_score",
              "metric": "safety_rating",
              "delta": 5
            },
            {
              "type": "add_score",
              "metric": "competency",
              "delta": 1,
              "competency_id": "coordination"
            }
          ]
        },
        {
          "id": "rush",
          "text": "Резко потянуть сумку, не предупредив пассажира",
          "destination": "unsafe",
          "explanation": "Несогласованное действие в модели создаёт лишний риск. Лучше сначала согласовать безопасный порядок действий.",
          "effects": [
            {
              "type": "add_score",
              "metric": "safety_rating",
              "delta": -10
            }
          ]
        }
      ],
      "timeout": {
        "destination": "expired",
        "explanation": "Запрос остался без ответа в условное время; доверие снизилось.",
        "effects": [
          {
            "type": "add_score",
            "metric": "passenger_loyalty",
            "delta": -3
          }
        ]
      }
    },
    {
      "id": "followup",
      "text": "Пассажир готов согласовать дальнейшую помощь.",
      "choices": [
        {
          "id": "explain",
          "text": "Спокойно объяснить согласованные следующие шаги",
          "destination": "done",
          "explanation": "Понятное объяснение уменьшает неопределённость и укрепляет доверие.",
          "effects": [
            {
              "type": "add_score",
              "metric": "passenger_loyalty",
              "delta": 5
            },
            {
              "type": "add_score",
              "metric": "competency",
              "delta": 1,
              "competency_id": "coordination"
            }
          ]
        },
        {
          "id": "leave",
          "text": "Уйти без объяснения",
          "destination": "done",
          "explanation": "Без объяснения пассажир остаётся в неопределённости; доверие снижается.",
          "effects": [
            {
              "type": "add_score",
              "metric": "passenger_loyalty",
              "delta": -3
            }
          ]
        }
      ]
    },
    {
      "id": "done",
      "text": "Учебная ситуация завершена. Посмотрите разбор действий.",
      "terminal": true
    },
    {
      "id": "unsafe",
      "text": "Попытка завершена с риском для безопасности. Сравните альтернативы в разборе.",
      "terminal": true
    },
    {
      "id": "expired",
      "text": "Время ответа истекло. Попробуйте ещё раз, не торопясь с оценкой риска.",
      "terminal": true
    }
  ]
}
