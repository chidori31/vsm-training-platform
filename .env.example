# Copy to .env and set a local password before starting Compose.
POSTGRES_DB=vsm
POSTGRES_USER=vsm
POSTGRES_PASSWORD=
# Local backend: replace the placeholder; URL-encode special characters.
DATABASE_URL=postgresql+psycopg://vsm:CHANGE_ME@localhost:5432/vsm
# Vite development proxy; browser requests stay same-origin.
API_PROXY_TARGET=http://127.0.0.1:8000
