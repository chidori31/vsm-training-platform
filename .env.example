# Copy to .env and set a local password before starting Compose.
POSTGRES_DB=vsm
POSTGRES_USER=vsm
POSTGRES_PASSWORD=
# Local backend: replace the placeholder; URL-encode special characters.
DATABASE_URL=postgresql+psycopg://vsm:CHANGE_ME@localhost:5432/vsm
# Vite development proxy; browser requests stay same-origin.
API_PROXY_TARGET=http://127.0.0.1:8000
# Server timeout worker polling interval (seconds).
TIMER_POLL_SECONDS=1
# Enable shared synthetic demo login for local development only.
DEMO_AUTH_ENABLED=true
# Host ports only; service-to-service ports remain unchanged.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Shared PostgreSQL command limits per 60 seconds (demo defaults).
RATE_LIMIT_AUTH_PER_MINUTE=120
RATE_LIMIT_START_PER_MINUTE=60
RATE_LIMIT_DECISION_PER_MINUTE=240
RATE_LIMIT_SHIFT_START_PER_MINUTE=30
RATE_LIMIT_SHIFT_ADVANCE_PER_MINUTE=120
